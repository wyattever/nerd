#!/bin/bash
# scrape_published — root-level convenience wrapper for
# scripts/scrape_ncademi_live.py --target published.
#
# Matches run_nerd()'s pattern (~/.zshrc) of a short command runnable from
# anywhere. Defaults to PRODUCTION: scraping now routinely targets real
# Firestore from the developer's terminal (Decision #66/#67), so a bare
# invocation forwards --prod to scrape_ncademi_live.py, which owns the
# actual production guard; this wrapper does not re-implement or duplicate
# that check. Pass --emulator to deliberately opt into the safer local
# target for testing instead.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

EMULATOR=0
for arg in "$@"; do
  case "${arg}" in
    --emulator) EMULATOR=1 ;;
    *)
      echo "Unknown argument: ${arg}" >&2
      echo "Usage: ./scrape_published [--emulator]" >&2
      exit 2
      ;;
  esac
done

# Activate the project venv unless one is already active.
if [ -z "${VIRTUAL_ENV:-}" ]; then
  source "${SCRIPT_DIR}/venv312/bin/activate"
fi

# --emulator opts into the local target, respecting an already-set host
# rather than overwriting it. Without --emulator, FIRESTORE_EMULATOR_HOST is
# left exactly as inherited -- production is reached simply because nothing
# sets it, matching the underlying script's own precedence (its emulator
# host, when present, always wins over --prod).
if [ "${EMULATOR}" -eq 1 ] && [ -z "${FIRESTORE_EMULATOR_HOST:-}" ]; then
  export FIRESTORE_EMULATOR_HOST=localhost:8080
fi

if [ -n "${FIRESTORE_EMULATOR_HOST:-}" ]; then
  FS_TARGET="${FIRESTORE_EMULATOR_HOST}"
else
  FS_TARGET="PRODUCTION"
fi
echo "[scrape_published] target=published  firestore=${FS_TARGET}"

ARGS=(--target published)
if [ "${EMULATOR}" -eq 0 ]; then
  ARGS+=(--prod)
fi

exec python3 "${SCRIPT_DIR}/scripts/scrape_ncademi_live.py" "${ARGS[@]}"

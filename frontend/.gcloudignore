# Cloud Build source-upload exclusions for builds submitted from frontend/.
# When this file exists, gcloud no longer reads .gitignore on its own, so it
# is pulled in explicitly on the next line. Everything below adds local-only
# material that is untracked but not gitignored.
#!include:.gitignore
.gcloudignore
.gitignore
.git
emulator-data/
*.log
test-results/
# Local data and working files that must never reach a Cloud Build upload.
# passwords.json holds vendor-review password values; no frontend code
# imports it, so the build does not need it.
lib/passwords.json
.scratch/
.claude/

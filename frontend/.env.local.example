# Copy to frontend/.env.local and fill in before running locally.
# Never commit .env.local.
#
# PHASE 2 SCOPE. These are only the variables the persistence tier needs to
# run locally against the Firestore emulator. Phase 3 (real auth), Phase 4
# (Python slim-down), and Phase 5 (scrape) add their own -- this file grows
# when they land, not before.
#
# Naming convention, load-bearing: NEXT_PUBLIC_* is inlined into the client
# bundle AT BUILD TIME; everything else is read only on the server at
# runtime.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Firestore project. REQUIRED and never defaulted -- lib/server/firebase-admin.ts
# throws if it is unset rather than letting the Admin SDK inherit
# GOOGLE_CLOUD_PROJECT, which is exported globally as `acp-vertex-core` on the
# build machine for unrelated tooling. See docs/DECISION_LOG.md #51.
NERD_FIREBASE_PROJECT_ID=edtech-agent-2026

# Points firebase-admin at the local Firestore emulator instead of live
# Firestore. Port matches firebase.json. Unset this to run against the real
# project (discouraged; see docs/nerd-local-dev-08-28-26.md).
FIRESTORE_EMULATOR_HOST=localhost:8080

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Base URL of the Python parse service behind the "Import Data" modal, no
# trailing slash. app/api/ingest/draft/route.ts defaults to
# http://localhost:8080, which collides with the Firestore emulator above --
# so set this explicitly when running the parser locally.
NERD_PY_SERVICE_URL=http://localhost:8081

# ---------------------------------------------------------------------------
# Required for build (not Phase 2 persistence, but /login prerenders and
# needs these to initialize Firebase Auth at build time)
# ---------------------------------------------------------------------------

# Firebase web SDK config -- non-secret. Retrieve via:
#   firebase apps:sdkconfig WEB --project prod
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyB-8Z2s-yNqHql4kOcdpKLnGLb-ta6YF_Q
NEXT_PUBLIC_FIREBASE_APP_ID=1:660897852208:web:d5b3fc1d50dbcade8476f5

# ---------------------------------------------------------------------------
# Phase 3 (real auth)
# ---------------------------------------------------------------------------

# Comma-separated sign-in allowlist, checked at session mint AND on every
# request. FAILS CLOSED: empty or unset denies everyone, including you.
# Set this before first sign-in or you will lock yourself out.
NERD_ALLOWED_EMAILS=
